# Copy this file to .env and fill values for local development
SECRET_KEY=replace-me-with-secret

# --- Database ---
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Postgres container reads these (docker-compose db service)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Cache / Celery broker ---
REDIS_HOST=redis

# --- Email (order confirmation via Celery) ---
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=web@example.com

# --- Production settings ---------------------------------------------------
# For LOCAL DEV leave DEBUG=True and the *_ORIGINS/ALLOWED_HOSTS unset (the
# defaults in settings.py already cover localhost).
#
# In PRODUCTION set DEBUG=False and fill the values below with your real
# domain. Comma-separated, no spaces. Example for domain sklep.example.com:
#
# DEBUG=False
# ALLOWED_HOSTS=sklep.example.com,www.sklep.example.com
# CORS_ALLOWED_ORIGINS=https://sklep.example.com
# CSRF_TRUSTED_ORIGINS=https://sklep.example.com
#
# When DEBUG=False the app enforces HTTPS (redirect + secure cookies + HSTS).
# If you serve plain HTTP inside a trusted LAN, also set:
# SECURE_SSL_REDIRECT=False
